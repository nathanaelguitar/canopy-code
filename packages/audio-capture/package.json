{
  "name": "@qwen-code/audio-capture",
  "version": "0.21.11",
  "description": "Native microphone capture backend for Qwen Code voice input",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "prebuilds",
    "scripts/*.js",
    "install.js"
  ],
  "scripts": {
    "install": "node install.js",
    "prebuildify": "npm run build:native && node scripts/package-rust-prebuild.js",
    "build:native": "node scripts/build-rust-addon.js",
    "build": "npm run build:native && tsc --build",
    "build:ts": "tsc --build",
    "test": "vitest run",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
