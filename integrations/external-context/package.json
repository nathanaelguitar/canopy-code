{
  "name": "@qwen-code/external-context",
  "version": "0.21.11",
  "private": true,
  "description": "Provider-bound external context for Qwen Code",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc --build && npm --prefix examples/provider-extension-local run build",
    "build:rust": "cargo build --manifest-path rust/Cargo.toml --release --locked",
    "build:rust:auto-recall": "cargo build --manifest-path rust/Cargo.toml --release --locked --bin auto-recall",
    "build:rust:extension": "node scripts/package-rust-extension.mjs",
    "build:rust:provider-context-extension": "node scripts/package-rust-extension.mjs --provider-context",
    "test": "vitest run --config vitest.config.ts",
    "test:ci": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit && npm --prefix examples/provider-extension-local run typecheck",
    "lint": "eslint src examples/provider-extension-local/src"
  },
  "files": [
    "contracts",
    "dist",
    "examples/*.json",
    "examples/provider-extension-local/README.md",
    "examples/provider-extension-local/dist/main.js",
    "examples/provider-extension-local/package.json",
    "examples/provider-extension-local/qwen-extension.json",
    "examples/provider-extension-local/src",
    "examples/provider-extension-local/tsconfig.json",
    "examples/provider-extension-remote",
    "qwen-extension.json",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "undici": "^7.28.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1",
    "typescript": "^5.4.5",
    "vitest": "^3.2.4"
  }
}
